# Copy to .env and fill in real values. Never commit .env.

# Cloud model (free tier, no credit card needed): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional local model via Ollama (https://ollama.com). If unset or Ollama
# isn't running, the engine falls back to Gemini for chat completions.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Single absolute root for db/chroma/workspace/voice data (must be absolute; usually
# leave unset - defaults to the ai-ecosystem data dir shared by every entry point).
# NEXUS_DATA_DIR=C:\Users\Asus\projects\ai-ecosystem\data
